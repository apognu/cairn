# Runs the bare binary under systemd. Put the binary at /usr/local/bin/cairn, Pagefind next to it, and the settings in
# /etc/cairn/env (see docs/DEPLOY.md), then: systemctl enable --now cairn
[Unit]
Description=cairn documentation server
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/cairn serve
EnvironmentFile=/etc/cairn/env
Environment=DATA_DIR=/var/lib/cairn BIND=127.0.0.1:8080 PAGEFIND_BIN=/usr/local/bin/pagefind
DynamicUser=yes
StateDirectory=cairn
Restart=on-failure
RestartSec=3

# The server needs its data directory and the network, nothing else.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes

[Install]
WantedBy=multi-user.target
