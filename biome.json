{
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "files": {
    "includes": [
      "packages/**",
      "examples/**",
      "*.json",
      "!**/dist",
      "!**/node_modules",
      "!**/src/api",
      "!**/test-results",
      "!**/.e2e-data",
      "!**/.cairn",
      "!**/.e2e-bundles",
      "!**/.e2e-custom-data",
      "!**/.e2e-api-data",
      "!**/.e2e-tmp-data",
      "!**/.e2e-serve-data",
      "!**/.work"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "rules": {
      "recommended": true
    }
  }
}
