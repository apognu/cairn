{
  "openapi": "3.1.0",
  "info": {
    "title": "yourdocs",
    "version": "0.0.0"
  },
  "paths": {
    "/api/assets": {
      "post": {
        "summary": "Uploads an image (the request body is the file). Uploading bytes that are already stored returns the existing asset.",
        "operationId": "uploadAsset",
        "requestBody": {
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "the same file was already stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Asset"
                }
              }
            }
          },
          "201": {
            "description": "stored as a new asset",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Asset"
                }
              }
            }
          },
          "413": {
            "description": "the file is too large"
          },
          "422": {
            "description": "not a supported image",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/pages": {
      "get": {
        "summary": "Every live page, ordered by position.",
        "operationId": "listPages",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Page"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Creates a page, or an external link when `external_url` is set, under `parent_id` (or at the root).",
        "operationId": "createPage",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePage"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "404": {
            "description": "unknown parent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "a sibling has the same URL segment",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/pages/{id}": {
      "post": {
        "summary": "Changes the title (the URL segment follows it) and, for a link, its target.",
        "operationId": "renamePage",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/PageId"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenamePage"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "a sibling has the same URL segment",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Deletes a page and its descendants.",
        "operationId": "deletePage",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/PageId"
            }
          }
        ],
        "responses": {
          "204": {},
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/pages/{id}/draft": {
      "get": {
        "summary": "The latest saved edits of a page (an empty document if it has none yet).",
        "operationId": "getDraft",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/PageId"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftResponse"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Saves a draft. Refused with 409 when `base_revision_id` is not the page's latest revision.",
        "operationId": "saveDraft",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/PageId"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveDraft"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftResponse"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "the page changed since the revision this save was based on",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/pages/{id}/move": {
      "post": {
        "summary": "Moves a page and its subtree under another parent.",
        "operationId": "movePage",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/PageId"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MovePage"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "a sibling has the same URL segment",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "the target is inside the page's own subtree",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/publish": {
      "post": {
        "summary": "Publishes the latest saved draft of every page as a new release.",
        "operationId": "publish",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Release"
                }
              }
            }
          },
          "422": {
            "description": "a page could not be rendered; nothing was published",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/settings": {
      "get": {
        "summary": "The site name, logo and accent color.",
        "operationId": "getSettings",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Saves the settings. They reach the published site with the next publish.",
        "operationId": "saveSettings",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Settings"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Asset": {
        "type": "object",
        "description": "An uploaded file. The bytes live in the `AssetStore` under the content hash; this is the row that describes them.",
        "required": [
          "id",
          "sha256",
          "mime",
          "bytes",
          "uploaded_by",
          "created_at"
        ],
        "properties": {
          "bytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "height": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "id": {
            "$ref": "#/components/schemas/AssetId"
          },
          "mime": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "description": "Hex SHA-256 of the file: two uploads of the same bytes are one asset."
          },
          "uploaded_by": {
            "$ref": "#/components/schemas/UserId"
          },
          "width": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "AssetId": {
        "type": "string",
        "description": "An uploaded file."
      },
      "CreatePage": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "before": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/PageId",
                "description": "Insert before this sibling; the page goes last when absent."
              },
              {
                "type": "null"
              }
            ]
          },
          "external_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "Makes the new node an external link to this URL instead of a page."
          },
          "parent_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/PageId"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "type": "string"
          }
        }
      },
      "Document": {
        "description": "A page body: the ProseMirror JSON of the editor, stored and rendered as is.\n\nBlock nodes carry a stable `attrs.id` (Tiptap UniqueID); internal links and components store page IDs and props in `attrs`."
      },
      "DraftResponse": {
        "type": "object",
        "required": [
          "doc"
        ],
        "properties": {
          "base_revision_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/RevisionId",
                "description": "The revision this draft is at; the next save must name it."
              },
              {
                "type": "null"
              }
            ]
          },
          "doc": {
            "$ref": "#/components/schemas/Document"
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "description": "The body of every error response.",
        "required": [
          "message",
          "details"
        ],
        "properties": {
          "details": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "message": {
            "type": "string"
          }
        }
      },
      "MovePage": {
        "type": "object",
        "properties": {
          "before": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/PageId"
              },
              {
                "type": "null"
              }
            ]
          },
          "parent_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/PageId"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Page": {
        "type": "object",
        "description": "A node of the page tree.",
        "required": [
          "id",
          "kind",
          "position",
          "slug",
          "title",
          "created_by",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "created_by": {
            "$ref": "#/components/schemas/UserId"
          },
          "external_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "Where a link goes; always `None` for pages."
          },
          "id": {
            "$ref": "#/components/schemas/PageId"
          },
          "kind": {
            "$ref": "#/components/schemas/PageKind"
          },
          "parent_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/PageId"
              },
              {
                "type": "null"
              }
            ]
          },
          "position": {
            "type": "string",
            "description": "Fractional index; siblings sort by this string."
          },
          "slug": {
            "type": "string",
            "description": "Lowercase, unique among siblings."
          },
          "title": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PageId": {
        "type": "string",
        "description": "Stable identity of a page; URLs derive from the tree, never from this."
      },
      "PageKind": {
        "type": "string",
        "description": "What a tree node is: a page of the site or a link to somewhere else.",
        "enum": [
          "page",
          "link"
        ]
      },
      "Release": {
        "type": "object",
        "description": "An immutable published state of the whole site.",
        "required": [
          "id",
          "created_by",
          "created_at",
          "status",
          "page_count"
        ],
        "properties": {
          "base_release_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ReleaseId",
                "description": "The live release this one was built on."
              },
              {
                "type": "null"
              }
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "created_by": {
            "$ref": "#/components/schemas/UserId"
          },
          "id": {
            "$ref": "#/components/schemas/ReleaseId"
          },
          "page_count": {
            "type": "integer",
            "format": "int32",
            "description": "How many pages the release contains.",
            "minimum": 0
          },
          "status": {
            "$ref": "#/components/schemas/ReleaseStatus"
          }
        }
      },
      "ReleaseId": {
        "type": "string",
        "description": "An immutable published state of the whole site."
      },
      "ReleaseStatus": {
        "type": "string",
        "enum": [
          "building",
          "live",
          "failed"
        ]
      },
      "RenamePage": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "external_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "The new target of a link; refused for pages."
          },
          "title": {
            "type": "string"
          }
        }
      },
      "RevisionId": {
        "type": "string",
        "description": "An immutable snapshot of a page's document."
      },
      "SaveDraft": {
        "type": "object",
        "required": [
          "doc"
        ],
        "properties": {
          "base_revision_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/RevisionId",
                "description": "The `base_revision_id` of the draft this edit started from, or null if the page had no draft."
              },
              {
                "type": "null"
              }
            ]
          },
          "doc": {
            "$ref": "#/components/schemas/Document"
          }
        }
      },
      "Settings": {
        "type": "object",
        "description": "The site-wide settings of the theme basics.",
        "required": [
          "site_name",
          "accent"
        ],
        "properties": {
          "accent": {
            "type": "string",
            "description": "`#rrggbb`."
          },
          "logo_asset_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/AssetId",
                "description": "An uploaded image shown before the site name in the header."
              },
              {
                "type": "null"
              }
            ]
          },
          "site_name": {
            "type": "string"
          }
        }
      },
      "UserId": {
        "type": "string",
        "description": "A user, including the built-in local one."
      }
    }
  }
}
