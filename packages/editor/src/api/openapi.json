{
  "openapi": "3.1.0",
  "info": {
    "title": "yourdocs",
    "version": "0.0.0"
  },
  "paths": {
    "/api/pages": {
      "get": {
        "summary": "Every live page, ordered by position.",
        "operationId": "listPages",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Page"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Creates a page under `parent_id` (or at the root).",
        "operationId": "createPage",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePage"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "404": {
            "description": "unknown parent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "a sibling has the same URL segment",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/pages/{id}": {
      "post": {
        "summary": "Changes the title; the URL segment follows it.",
        "operationId": "renamePage",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/PageId"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenamePage"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "a sibling has the same URL segment",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Deletes a page and its descendants.",
        "operationId": "deletePage",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/PageId"
            }
          }
        ],
        "responses": {
          "204": {},
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/pages/{id}/move": {
      "post": {
        "summary": "Moves a page and its subtree under another parent.",
        "operationId": "movePage",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/PageId"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MovePage"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "a sibling has the same URL segment",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "the target is inside the page's own subtree",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreatePage": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "before": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/PageId",
                "description": "Insert before this sibling; the page goes last when absent."
              },
              {
                "type": "null"
              }
            ]
          },
          "parent_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/PageId"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "type": "string"
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "description": "The body of every error response.",
        "required": [
          "message",
          "details"
        ],
        "properties": {
          "details": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "message": {
            "type": "string"
          }
        }
      },
      "MovePage": {
        "type": "object",
        "properties": {
          "before": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/PageId"
              },
              {
                "type": "null"
              }
            ]
          },
          "parent_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/PageId"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Page": {
        "type": "object",
        "description": "A node of the page tree.",
        "required": [
          "id",
          "position",
          "slug",
          "title",
          "created_by",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "created_by": {
            "$ref": "#/components/schemas/UserId"
          },
          "id": {
            "$ref": "#/components/schemas/PageId"
          },
          "parent_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/PageId"
              },
              {
                "type": "null"
              }
            ]
          },
          "position": {
            "type": "string",
            "description": "Fractional index; siblings sort by this string."
          },
          "slug": {
            "type": "string",
            "description": "Lowercase, unique among siblings."
          },
          "title": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PageId": {
        "type": "string",
        "description": "Stable identity of a page; URLs derive from the tree, never from this."
      },
      "RenamePage": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string"
          }
        }
      },
      "UserId": {
        "type": "string",
        "description": "A user, including the built-in local one."
      }
    }
  }
}
