          "text": "Install the CLI"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Use your package manager."
        }
      ]
    },
    {
      "type": "tabs",
      "attrs": {
        "variant": "code"
      },
      "content": [
        {
          "type": "tabPanel",
          "attrs": {
            "label": "npm"
          },
