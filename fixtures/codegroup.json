            {
              "type": "codeBlock",
              "attrs": {
                "language": "bash"
              },
              "content": [
                {
                  "type": "text",
                  "text": "npm install --global halyard"
                }
              ]
            }
          ]
        },
        {
          "type": "tabPanel",
          "attrs": {
            "label": "yarn"
          },
