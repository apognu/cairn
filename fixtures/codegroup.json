            {
              "type": "codeBlock",
              "attrs": {
                "language": "bash"
              },
              "content": [
                {
                  "type": "text",
                  "text": "yarn global add halyard"
                }
              ]
            }
          ]
        },
        {
          "type": "tabPanel",
          "attrs": {
            "label": "pnpm"
