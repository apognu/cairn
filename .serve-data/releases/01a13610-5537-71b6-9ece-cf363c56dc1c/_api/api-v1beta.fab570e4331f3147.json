{"ApiKeyAuth":[]}],"summary":"Attach annotations to an record","tags":["Record"]}},"/records/{recordType}/{recordId}/annotations/files":{"post":{"description":"Upload one or more files and attach them as a file annotation to a specific record.\n","operationId":"createRecordFileAnnotation","parameters":[{"description":"Type of the record as defined in the data model","in":"path","name":"recordType","required":true,"schema":{"type":"string"}},{"description":"Client-side ID of the record","in":"path","name":"recordId","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"multipart/form-data":{"schema":{"properties":{"caption":{"description":"Caption for the uploaded files","type":"string"},"files[]":{"description":"One or more files to attach. At least one file is required.","items":{"format":"binary","type":"string"},"maxItems":100,"minItems":1,"type":"array"}},"required":["caption","files[]"],"type":"object"}}},"required":true},"responses":{"201":{"content":{"application/json":{"schema":{"allOf":[{"$ref":"#/components/schemas/BaseResponse"},{"properties":{"data":{"items":{"$ref":"#/components/schemas/RecordAnnotation"},"type":"array"}},"type":"object"}]}}},"description":"File annotation(s) created"},"400":{"$ref":"#/components/responses/400"},"404":{"$ref":"#/components/responses/404"}},"security":[{"BearerTokenAuth":[]},{"ApiKeyAuth":[]}],"summary":"Attach files to a record as an annotation","tags":["Record"]}},"/risk-levels/{objectType}/{objectId}":{"get":{"operationId":"getActiveRiskLevel","parameters":[{"in":"path","name":"objectType","required":true,"schema":{"type":"string"}},{"in":"path","name":"objectId","required":true,"schema":{"type":"string"}}],"responses":{"200":{"content":{"application/json":{"schema":{"allOf":[{"$ref":"#/components/schemas/BaseResponse"},{"properties":{"data":{"$ref":"#/components/schemas/RecordRiskLevel"}},"type":"object"}]}}},"description":"Current risk level"},"400":{"$ref":"#/components/responses/400"},"404":{"$re