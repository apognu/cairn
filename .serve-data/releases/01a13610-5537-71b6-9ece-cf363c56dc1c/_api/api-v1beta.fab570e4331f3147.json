yAuth":[]}],"summary":"Upload a CSV file that will be ingested asynchronously","tags":["Ingestion"]}},"/records/annotations":{"delete":{"description":"Delete one or more annotations by their IDs.\n\nThis operation is idempotent — IDs that do not exist are silently ignored. All deletions are performed atomically.\n","operationId":"deleteRecordAnnotations","requestBody":{"content":{"application/json":{"schema":{"properties":{"ids":{"items":{"format":"uuid","type":"string"},"maxItems":100,"minItems":1,"type":"array"}},"required":["ids"],"type":"object"}}},"required":true},"responses":{"204":{"description":"Annotations deleted"},"400":{"$ref":"#/components/responses/400"}},"security":[{"BearerTokenAuth":[]},{"ApiKeyAuth":[]}],"summary":"Delete annotations by ID","tags":["Record"]}},"/records/annotations/{id}/files/{partId}/download":{"get":{"description":"Download a specific file within a file annotation.\n","operationId":"downloadRecordAnnotationFile","parameters":[{"description":"ID of the file annotation","in":"path","name":"id","required":true,"schema":{"format":"uuid","type":"string"}},{"description":"Filename of the specific file part within the annotation","in":"path","name":"partId","required":true,"schema":{"type":"string"}}],"responses":{"302":{"$ref":"#/components/responses/302"},"400":{"$ref":"#/components/responses/400"},"404":{"$ref":"#/components/responses/404"}},"security":[{"BearerTokenAuth":[]},{"ApiKeyAuth":[]}],"summary":"Download a file annotation part","tags":["Record"]}},"/records/{recordType}/{recordId}/annotations":{"get":{"description":"List all annotations attached to a specific record.\n","operationId":"listRecordAnnotations","parameters":[{"description":"Type of the record as defined in the data model","in":"path","name":"recordType","required":true,"schema":{"type":"string"}},{"description":"Client-side ID of the record","in":"path","name":"recordId","required":true,"schema":{"type":"string"}}],"responses":{"200":{"content":{"application/js