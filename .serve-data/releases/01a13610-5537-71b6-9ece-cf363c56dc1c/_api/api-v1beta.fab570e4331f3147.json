rerTokenAuth":[]},{"ApiKeyAuth":[]}],"summary":"Remove a tag from a case","tags":["Cases"]}},"/continuous-screenings/objects":{"delete":{"operationId":"removeContinuousScreeningObject","requestBody":{"content":{"application/json":{"schema":{"properties":{"config_stable_id":{"format":"uuid","type":"string"},"object_id":{"type":"string"},"object_type":{"type":"string"}},"required":["object_type","object_id","config_stable_id"],"type":"object"}}},"required":true},"responses":{"204":{"description":"Monitored object deleted"},"400":{"$ref":"#/components/responses/400"},"403":{"$ref":"#/components/responses/403"},"404":{"$ref":"#/components/responses/404"}},"security":[{"BearerTokenAuth":[]},{"ApiKeyAuth":[]}],"summary":"Remove an object from continuous screening","tags":["Continuous Screenings"]},"post":{"description":"This endpoint is idempotent. If the object is already under monitoring, the call succeeds and\nre-runs the screening, returning the latest result. It is safe to retry this call to retrieve\nan up-to-date screening result.\n","operationId":"addContinuousScreeningObject","requestBody":{"content":{"application/json":{"schema":{"properties":{"config_stable_id":{"format":"uuid","type":"string"},"object_id":{"type":"string"},"object_type":{"type":"string"},"skip_screen":{"default":false,"description":"Whether to skip screening the object immediately. If true, the API returns 201 Created without data.","type":"boolean"}},"required":["object_type","object_id","config_stable_id"],"type":"object"}}},"required":true},"responses":{"201":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ContinuousScreening"}}},"description":"Monitored object added or already existed. Returns the latest screening result if screening was performed, or an empty response if screening was skipped."},"400":{"$ref":"#/components/responses/400"},"403":{"$ref":"#/components/responses/403"}},"security":[{"BearerTokenAuth":[]},{"ApiKeyAuth":[]}],"summary":"Add an object under continuous screening with given configuration","tags":["Continuous Screenings"]}},"/decisions/async":{"post":{"description":"Enqueue multiple asynchronous decision executions at once.\n\nWhen `ingest` is true, the object will be ingested before decisions are created. Note that this endpoint is not compatible with\noptional side effects of ingestion, such as addition to continuous screening (though if the record is already being monitored,\nit will trigger a new screening with the updated data).\n\nAll trigger objects are validated against the data model on reception. If any object fails validation, the entire batch is rejected with per-object error details.\nEach object is processed independently in the background.\n","operationId":"createAsyncDecisionBatch","requestBody":{"content":{"application/json":{"schema":{"anyOf":[{"required":["trigger_object_type"]},{"required":["scenario_id"]}],"properties":{"ingest":{"default":false,"description":"Whether to ingest each trigger object before creating decisions","type":"boolean"},"scenario_id":{"description":"Optional scenario ID to restrict execution to a single scenario.\nAt least one of `trigger_object_type` or `scenario_id` must be provided.\n","format":"uuid","type":"string"},"trigger_object_type":{"description":"Name of the data model table for the trigger objects.\nAt least one of `trigger_object_type` or `scenario_id` must be provided.\nWhen only `scenario_id` is provided, the trigger object type is derived from the scenario.\n","type":"string"},"trigger_objects":{"description":"Array of trigger object payloads (1 to 100 objects)","items":{"additionalProperties":true,"type":"object"},"maxItems":100,"minItems":1,"type":"array"}},"required":["trigger_objects"],"type":"object"}}}},"responses":{"201":{"content":{"application/json":{"schema":{"allOf":[{"$ref":"#/components/schemas/BaseResponse"},{"properties":{"data":{"items":{"$ref":"#/components/schemas/AsyncDecisionExecutionCreated"},"type":"array"}},"type":"object"}]}}},"description":"Async decision executions created"},"400":{"$ref":"#/components/responses/400"}},"security":[{"BearerTokenAuth":[]},{"ApiKeyAuth":[]}],"summary":"Create a batch of async decision executions","tags":["Async Decisions"]}},"/decisions/async/{executionId}":{"get":{"description":"Retrieve the current status and details of an async decision execution.\nOld executions are kept for 30 days after completion, so the endpoint may\nreturn a 404 status for old executions that have been deleted.\n","operationId":"getAsyncDecisionExecution","parameters":[{"description":"ID of the async decision execution","in":"path","name":"executionId","required":true,"schema":{"format":"uuid","type":"string"}}],"responses":{"200":{"content":{"application/json":{"schema":{"allOf":[{"$ref":"#/components/schemas/BaseResponse"},{"properties":{"data":{"$ref":"#/components/schemas/AsyncDecisionExecution"}},"type":"object"}]}}},"description":"Async decision execution details"},"400":{"$ref":"#/components/responses/400"},"404":{"$ref":"#/components/responses/404"}},"security":[{"BearerTokenAuth":[]},{"ApiKeyAuth":[]}],"summary":"Get async decision execution status","tags":["Async Decisions"]}},"/ingest/{objectType}/uploads":{"get":{"operationId":"listBatchIngestionLogs","parameters":[{"description":"Filter decisions by their scenario","in":"path","name":"objectType","required":true,"schema":{"type":"string"}},{"description":"Only show logs in a specific status","in":"query","name":"status","schema":{"enum":["pending processing success failure"],"type":"string"}},{"$ref":"#/components/parameters/limit"},{"$ref":"#/components/parameters/after"}],"responses":{"200":{"content":{"application/json":{"schema":{"allOf":[{"$ref":"#/components/schemas/BaseResponse"},{"$ref":"#/components/schemas/BasePagination"},{"properties":{"data":{"items":{"$ref":"#/components/schemas/BatchIngestionLog"},"type":"array"}},"type":"object"}]}}},"description":"List of batch ingestion events"},"400":{"$ref":"